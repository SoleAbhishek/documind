# ==========================================
# DocuMind Environment Configuration
# ==========================================

# Application Settings
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL)
# Async URL for FastAPI SQLAlchemy async engine
DATABASE_URL=postgresql+asyncpg://documind:documind_secret@localhost:5433/documind_db
# Sync URL for Alembic migrations or sync scripts
SYNC_DATABASE_URL=postgresql://documind:documind_secret@localhost:5433/documind_db

# Hybrid Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documind_hybrid_chunks

# Object Storage (S3 / MinIO)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_BUCKET_NAME=documind-documents
S3_REGION=us-east-1

# Document OCR & Parsing (LlamaParse)
# Get a free key with 1000 free pages/day at: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-your-llamaparse-api-key

# Google Gemini Models (Get API key from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy-your-gemini-api-key
GEMINI_EMBEDDING_MODEL=text-embedding-005
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Free Local Reranker
# Options:
# - "BAAI/bge-reranker-base" (HuggingFace sentence-transformers, top accuracy)
# - "ms-marco-MiniLM-L-6-v2" (fast cross-encoder)
# - "flashrank" (quantized CPU reranker)
RERANKER_MODEL=BAAI/bge-reranker-base
